# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_api_key_here

# Redis Configuration (optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Cache Settings
ENABLE_CACHE=true
CACHE_TTL_SECONDS=86400

# LLM Settings
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7
